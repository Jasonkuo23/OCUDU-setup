cu_up:
  e1ap:
    addrs: ${E1_CP_IP}
    bind_addrs: ${E1_UP_IP}
  ngu:
    socket:
      - bind_addr: ${N3_LOCAL_IP}
  f1u:
    socket:
      - bind_addr: ${F1_CP_IP}

log:
  # Docker-native logging avoids delayed file-buffer flushes.
  filename: stdout
  all_level: info

pcap:
  e1ap_enable: true
  e1ap_filename: /var/log/ocudu/cu-up-e1ap.pcap
  f1u_enable: true
  f1u_filename: /var/log/ocudu/cu-up-f1u.pcap
  n3_enable: true
  n3_filename: /var/log/ocudu/cu-up-n3.pcap
