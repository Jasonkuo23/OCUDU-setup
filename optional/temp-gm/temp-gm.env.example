# Optional simulated temporary GM settings. This feature is disabled unless an
# operator explicitly enters this directory, creates temp-gm.env and runs it.
PTP_ROLE=temp-gm
PTP_RUN_DIR=/run/ocudu-temp-gm
PTP_CPU=0
PHC2SYS_CPU=1
ISOLATED_SERVO=0
HOLDOVER_MAX_SECONDS=7200
TARGET_FREQUENCY_PPB=8900
PHC_STABILITY_TIMEOUT_SECONDS=180
PHC_STABLE_SAMPLE_COUNT=30
PHC_FREQUENCY_SPREAD_PPB=500
PHC_SANITY_FREQ_LIMIT_PPB=200000
